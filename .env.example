# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Hugging Face User Access Token for Stable Diffusion cloud inference
# (Get yours from: https://huggingface.co/settings/tokens)
HF_API_KEY=your_huggingface_api_key

# Optional: Set to 'true' if you have a local GPU and wish to run local diffusers pipeline
USE_LOCAL_DIFFUSERS=false
SD_MODEL_ID=stabilityai/sd-turbo
